# ── Required ──────────────────────────────────────────────────────────

# pscale agent secret — used as the HMAC key for per-grain passphrase
# derivation. Rotating this invalidates revocation authority on
# previously-issued grains, so do it carefully. Generate with:
#   openssl rand -hex 32
TICKET_AGENT_SECRET=

# Bearer token gating /admin/* endpoints. Generate with:
#   openssl rand -hex 32
ADMIN_TOKEN=

# ── Stripe (only if you have stripe-driver products) ─────────────────

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Optional ─────────────────────────────────────────────────────────

# Path to the YAML config declaring products. Default: ./config/agent.yaml
TICKET_AGENT_CONFIG=./config/agent.yaml

# If set, POSTed when a per-product rate-limit cap is hit at issuance.
# Useful for paging the operator. Body: JSON with event="rate_limit_cap_hit".
RATE_LIMIT_WEBHOOK=

# HTTP
PORT=8080
PUBLIC_URL=http://localhost:8080

# Logging — one of trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# Storage — SQLite holds fiat-side state only (purchases, idempotency,
# refund tracking). Ticket truth lives on the substrate.
PURCHASES_DB_PATH=./data/purchases.sqlite
